# Template file for 'foundry'
pkgname=foundry
version=1.2.0
revision=1
build_style=meson
build_helper="gir"
configure_args="-Ddocs=false -Dplugin-deviced=false"
hostmakedepends="pkg-config glib-devel gettext gobject-introspection"
makedepends="libglib-devel gtk4-devel libadwaita-devel libdex-devel libpanel-devel
 libpeas2-devel json-glib-devel template-glib-devel gom-devel flatpak-devel
 libgit2-devel libssh2-devel libsecret-devel libsoup3-devel libspelling-devel
 libxml2-devel libyaml-devel editorconfig-devel cmark-devel libwebkitgtk60-devel
 gtksourceview5-devel vte3-gtk4-devel sysprof-devel readline-devel"
short_desc="IDE tooling library and command line tool from GNOME Builder"
maintainer="Orphaned <orphan@voidlinux.org>"
license="LGPL-2.1-or-later"
homepage="https://gitlab.gnome.org/GNOME/foundry"
changelog="https://gitlab.gnome.org/GNOME/foundry/-/raw/main/NEWS"
distfiles="${GNOME_SITE}/foundry/${version%.*}/foundry-${version}.tar.xz"
checksum=7c86aa790c895206b668c9f18c21a8f5d20078bd9b271f9877694d31e9564b34

foundry-devel_package() {
	depends="${makedepends} ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
		vmove usr/share/gir-1.0
	}
}
